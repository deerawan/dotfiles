# Git worktree + cmux workspace functions
# Ported from https://github.com/roderik/dotfiles-2026/.config/fish/functions/

__wt_repo_root() {
  local root
  root=$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //')
  if [[ -n "$root" ]]; then
    echo "$root"
    return 0
  fi

  root=$(for d in ~/Development/*/; do
    [[ -d "$d/.git" ]] && echo "${d%/}"
  done | sort | fzf --height=40% --reverse --header "Select repo" --with-nth=-1 --delimiter=/)

  if [[ -n "$root" ]]; then
    echo "$root"
    return 0
  fi
  return 1
}

__wt_install_deps() {
  [[ -f pnpm-lock.yaml ]] && { pnpm install; return; }
  [[ -f yarn.lock ]] && { yarn install; return; }
  [[ -f package-lock.json ]] && { npm install; return; }
}

# Path of the worktree holding $branch, per git itself.
__wt_worktree_path() {
  local repo_root="$1" branch="$2"
  git -C "$repo_root" worktree list --porcelain 2>/dev/null \
    | awk -v b="refs/heads/$branch" '/^worktree /{p=substr($0,10)} $0=="branch "b{print p; exit}'
}

# True only inside the tool that owns this shell. Both binaries can be on PATH,
# and herdr's daemon answers CLI calls, from a terminal neither of them manages —
# dispatching on that would open a workspace the user is not looking at.
__wt_in_herdr() {
  [[ "${HERDR_ENV:-}" == 1 ]] && command -v herdr &>/dev/null
}

__wt_in_cmux() {
  [[ -n "${CMUX_WORKSPACE_ID:-}" ]] && command -v cmux &>/dev/null
}

# Open $branch's worktree as its own herdr workspace and echo "<workspace_id> <root_pane_id>".
# Binding the workspace to the worktree is what nests it under the repo in the sidebar,
# so the worktree must already exist before this is called.
__wt_herdr_open() {
  local repo_root="$1" branch="$2"

  local wt_path
  wt_path=$(__wt_worktree_path "$repo_root" "$branch")
  if [[ -z "$wt_path" ]]; then
    echo "herdr: could not locate the worktree for '$branch'" >&2
    return 1
  fi

  local ws_json
  ws_json=$(herdr worktree open --cwd "$repo_root" --path "$wt_path" --label "$branch" --focus 2>/dev/null)

  local ws_id ws_pane
  ws_id=$(jq -r '.result.workspace.workspace_id // empty' <<<"$ws_json")
  ws_pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$ws_json")
  if [[ -z "$ws_pane" ]]; then
    echo "herdr: failed to open a workspace for '$branch'" >&2
    return 1
  fi

  if [[ $(jq -r '.result.already_open // false' <<<"$ws_json") == true ]]; then
    echo "herdr: reusing the workspace already open on '$branch'" >&2
  fi

  echo "$ws_id $ws_pane"
}

__wt_cmux_rename() {
  local name="$1"
  [[ -z "$name" ]] && return
  command -v cmux &>/dev/null || return
  [[ -n "$CMUX_WORKSPACE_ID" ]] || return
  cmux workspace-action --action rename --title "$name" 2>/dev/null
}

__wt_cmux_setup() {
  command -v cmux &>/dev/null || return 0

  local force=false
  local initial_prompt=""
  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      --prompt=*) initial_prompt="${arg#--prompt=}" ;;
    esac
  done

  # Resolve workspace ID
  local ws_id
  if [[ -n "$CMUX_WORKSPACE_ID" ]]; then
    ws_id="$CMUX_WORKSPACE_ID"
  else
    ws_id=$(cmux identify --json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['caller']['workspace_ref'])" 2>/dev/null)
  fi
  if [[ -z "$ws_id" ]]; then
    echo "cmux: not in a workspace — skipping layout setup"
    return 1
  fi

  local workdir="$PWD"

  # Get current pane topology
  local main_pane
  main_pane=$(cmux list-panes --workspace "$ws_id" 2>/dev/null | grep -oE 'pane:[0-9]+' | head -1)
  if [[ -z "$main_pane" ]]; then
    echo "cmux: could not detect panes"
    return 1
  fi

  # Idempotency guard — skip if layout already has multiple panes
  local pane_count
  pane_count=$(cmux list-panes --workspace "$ws_id" 2>/dev/null | grep -cE 'pane:[0-9]+')
  if [[ "$pane_count" -gt 1 ]] && [[ "$force" == false ]]; then
    return 0
  fi

  local main_surface
  main_surface=$(cmux list-pane-surfaces --workspace "$ws_id" --pane "$main_pane" 2>/dev/null | grep -oE 'surface:[0-9]+' | head -1)
  if [[ -z "$main_surface" ]]; then
    echo "cmux: could not detect main surface"
    return 1
  fi

  # 1. Right split → lazygit (full height, narrow)
  local lg_surface
  lg_surface=$(cmux new-split right --workspace "$ws_id" 2>/dev/null | grep -oE 'surface:[0-9]+' | head -1)
  if [[ -n "$lg_surface" ]]; then
    cmux resize-pane --workspace "$ws_id" --pane "$main_pane" -R --amount 200 2>/dev/null
    cmux send --workspace "$ws_id" --surface "$lg_surface" "cd '$workdir' && lazygit\n" 2>/dev/null
    cmux rename-tab --workspace "$ws_id" --surface "$lg_surface" "Git" 2>/dev/null
  fi

  # 2. Bottom split under main → terminal
  local term_surface
  term_surface=$(cmux new-split down --workspace "$ws_id" --surface "$main_surface" 2>/dev/null | grep -oE 'surface:[0-9]+' | head -1)
  if [[ -n "$term_surface" ]]; then
    cmux resize-pane --workspace "$ws_id" --pane "$main_pane" -D --amount 200 2>/dev/null
    cmux send --workspace "$ws_id" --surface "$term_surface" "cd '$workdir'\n" 2>/dev/null
    cmux rename-tab --workspace "$ws_id" --surface "$term_surface" "Terminal" 2>/dev/null
  fi

  # 3. Start Claude in main pane
  cmux focus-pane --pane "$main_pane" --workspace "$ws_id" 2>/dev/null
  local claude_cmd='claude --permission-mode auto'
  if [[ -n "$initial_prompt" ]]; then
    # Prompt is constructed without single quotes upstream (see wtj) so '...' wrapping is safe.
    claude_cmd="claude --permission-mode auto '$initial_prompt'"
  fi
  cmux send --workspace "$ws_id" --surface "$main_surface" "$claude_cmd"$'\n' 2>/dev/null
}

__wt_herdr_setup() {
  __wt_in_herdr || return 0

  local force=false
  local initial_prompt=""
  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      --prompt=*) initial_prompt="${arg#--prompt=}" ;;
    esac
  done

  # herdr injects the caller's pane context into every managed pane
  local main_pane="$HERDR_PANE_ID"
  if [[ -z "$main_pane" ]]; then
    echo "herdr: not in a managed pane — skipping layout setup"
    return 1
  fi

  local workdir="$PWD"

  # Idempotency guard — skip if layout already has multiple panes
  local pane_count
  pane_count=$(herdr pane layout --pane "$main_pane" 2>/dev/null | jq '.result.layout.panes | length' 2>/dev/null)
  if [[ "$pane_count" -gt 1 ]] && [[ "$force" == false ]]; then
    return 0
  fi

  # 1. Right split → lazygit (full height, narrow). --ratio is the original pane's share.
  local lg_pane
  lg_pane=$(herdr pane split "$main_pane" --direction right --ratio 0.72 --cwd "$workdir" --no-focus 2>/dev/null \
    | jq -r '.result.pane.pane_id // empty')
  if [[ -n "$lg_pane" ]]; then
    herdr pane rename "$lg_pane" "Git" >/dev/null 2>&1
    herdr pane run "$lg_pane" "lazygit" >/dev/null 2>&1
  fi

  # 2. Bottom split under main → terminal
  local term_pane
  term_pane=$(herdr pane split "$main_pane" --direction down --ratio 0.75 --cwd "$workdir" --no-focus 2>/dev/null \
    | jq -r '.result.pane.pane_id // empty')
  [[ -n "$term_pane" ]] && herdr pane rename "$term_pane" "Terminal" >/dev/null 2>&1

  # 3. Start Claude in main pane
  local claude_cmd='claude --permission-mode auto'
  if [[ -n "$initial_prompt" ]]; then
    # Prompt is constructed without single quotes upstream so '...' wrapping is safe.
    claude_cmd="claude --permission-mode auto '$initial_prompt'"
  fi
  herdr pane run "$main_pane" "$claude_cmd" >/dev/null 2>&1
}

wtc() {
  local branch="$1"
  [[ -z "$branch" ]] && { echo "Usage: wtc <branch-name>"; return 1; }

  local repo_root
  repo_root=$(__wt_repo_root) || return
  [[ -z "$repo_root" ]] && return

  # Always open the branch in its own workspace — never take over the current one.
  if __wt_in_herdr; then
    # Create the worktree here so herdr can bind the workspace to it.
    ( cd "$repo_root" && git fetch origin main && wt switch --create --base origin/main "$branch" ) || return 1

    local ws_id ws_pane
    read -r ws_id ws_pane <<<"$(__wt_herdr_open "$repo_root" "$branch")" || return 1
    [[ -z "$ws_pane" ]] && return 1

    herdr pane run "$ws_pane" "__wt_install_deps && __wt_herdr_setup" >/dev/null 2>&1

    echo "Workspace '$branch' ($ws_id) created."
  elif __wt_in_cmux; then
    # Create a new cmux workspace and send all commands to it
    local ws_uuid
    ws_uuid=$(cmux new-workspace 2>/dev/null | awk '{print $2}')
    if [[ -z "$ws_uuid" ]]; then
      echo "cmux: failed to create new workspace"
      return 1
    fi

    # Rename workspace
    cmux workspace-action --action rename --workspace "$ws_uuid" --title "$branch" 2>/dev/null

    # Get the main surface of the new workspace
    local ws_pane ws_surface
    ws_pane=$(cmux list-panes --workspace "$ws_uuid" 2>/dev/null | grep -oE 'pane:[0-9]+' | head -1)
    ws_surface=$(cmux list-pane-surfaces --workspace "$ws_uuid" --pane "$ws_pane" 2>/dev/null | grep -oE 'surface:[0-9]+' | head -1)

    # Send worktree creation + layout setup to the new workspace's terminal
    cmux send --workspace "$ws_uuid" --surface "$ws_surface" \
      "cd '$repo_root' && git fetch origin main && wt switch --create --base origin/main $branch && __wt_install_deps && __wt_cmux_setup\n" 2>/dev/null

    echo "Workspace '$branch' created."
  else
    # No herdr/cmux — just create worktree in current shell
    cd "$repo_root" && git fetch origin main && wt switch --create --base origin/main "$@" && __wt_install_deps || return 1
    echo ""
    echo "Worktree created: $PWD"
  fi
}

wtpr() {
  local input="$1"
  [[ -z "$input" ]] && { echo "Usage: wtpr <pr-number|pr-url>"; return 1; }

  local pr_number
  local -a gh_repo_flag=()
  if [[ "$input" == https://github.com/*/pull/* ]]; then
    local repo_nwo="${input#https://github.com/}"
    repo_nwo="${repo_nwo%%/pull/*}"
    pr_number="${input#*/pull/}"   # strip up to and incl. /pull/
    pr_number="${pr_number%%/*}"   # drop trailing /files, /commits, etc.
    pr_number="${pr_number%%[#?]*}" # drop #anchor or ?query
    gh_repo_flag=(--repo "$repo_nwo")
  else
    pr_number="$input"
  fi

  local repo_root
  repo_root=$(__wt_repo_root) || return
  [[ -z "$repo_root" ]] && return

  local branch
  branch=$(cd "$repo_root" && gh pr view "$pr_number" "${gh_repo_flag[@]}" --json headRefName -q .headRefName 2>/dev/null)
  if [[ -z "$branch" ]]; then
    echo "Error: could not resolve branch for PR #$pr_number"
    return 1
  fi

  # Always open the PR in its own workspace — never take over the current one.
  if __wt_in_herdr; then
    # Create the worktree here so herdr can bind the workspace to it.
    ( cd "$repo_root" && git fetch origin "$branch" && wt switch "$branch" ) || return 1

    local ws_id ws_pane
    read -r ws_id ws_pane <<<"$(__wt_herdr_open "$repo_root" "$branch")" || return 1
    [[ -z "$ws_pane" ]] && return 1

    herdr pane run "$ws_pane" "__wt_install_deps && __wt_herdr_setup" >/dev/null 2>&1

    echo "Workspace '$branch' ($ws_id) created for PR #$pr_number."
  elif __wt_in_cmux; then
    local ws_uuid
    ws_uuid=$(cmux new-workspace 2>/dev/null | awk '{print $2}')
    if [[ -z "$ws_uuid" ]]; then
      echo "cmux: failed to create new workspace"
      return 1
    fi

    cmux workspace-action --action rename --workspace "$ws_uuid" --title "$branch" 2>/dev/null

    local ws_pane ws_surface
    ws_pane=$(cmux list-panes --workspace "$ws_uuid" 2>/dev/null | grep -oE 'pane:[0-9]+' | head -1)
    ws_surface=$(cmux list-pane-surfaces --workspace "$ws_uuid" --pane "$ws_pane" 2>/dev/null | grep -oE 'surface:[0-9]+' | head -1)

    cmux send --workspace "$ws_uuid" --surface "$ws_surface" \
      "cd '$repo_root' && git fetch origin $branch && wt switch $branch && __wt_install_deps && __wt_cmux_setup\n" 2>/dev/null

    echo "Workspace '$branch' created for PR #$pr_number."
  else
    cd "$repo_root" && git fetch origin "$branch" && wt switch "$branch" && __wt_install_deps || return 1
    echo ""
    echo "Worktree created for PR #$pr_number: $PWD"
  fi
}

wtj() {
  local input="$1"
  [[ -z "$input" ]] && { echo "Usage: wtj <jira-ticket>  (e.g. wtj vp-3501)"; return 1; }

  if [[ ! "$input" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]]; then
    echo "Error: '$input' does not look like a JIRA ticket (expected e.g. VP-3501)"
    return 1
  fi

  local jira_key="${(U)input}"   # VP-3501
  local branch="${(L)input}"     # vp-3501

  local repo_root
  repo_root=$(__wt_repo_root) || return
  [[ -z "$repo_root" ]] && return

  # Prompt intentionally single-quote-free so it can be wrapped in '...' when sent into the workspace shell.
  # The rename step differs per workspace manager, so it is spliced in by the branches below.
  local jira_prompt_pre="You are working in a workspace for JIRA ticket ${jira_key}. Please: (1) fetch the ticket title and description via the Atlassian MCP (mcp__claude_ai_Atlassian__getJiraIssue); (2) rename this workspace by running in bash: "
  local jira_prompt_post=" — pick a concise 3-6 word summary from the ticket title; (3) explore the codebase and draft an implementation plan for this ticket before making changes."
  local jira_prompt prompt_arg

  # Always open the ticket in its own workspace — never take over the current one.
  if __wt_in_herdr; then
    # Create the worktree here so herdr can bind the workspace to it.
    ( cd "$repo_root" && git fetch origin main && wt switch --create --base origin/main "$branch" ) || return 1

    local ws_id ws_pane
    read -r ws_id ws_pane <<<"$(__wt_herdr_open "$repo_root" "$branch")" || return 1
    [[ -z "$ws_pane" ]] && return 1

    # \$HERDR_WORKSPACE_ID stays literal so it expands in the agent's own shell.
    jira_prompt="${jira_prompt_pre}herdr workspace rename \"\$HERDR_WORKSPACE_ID\" \"${jira_key} <short-title>\"${jira_prompt_post}"
    # %q-escape the prompt so it survives being embedded in the outer command string.
    prompt_arg=$(printf '%q' "$jira_prompt")

    herdr pane run "$ws_pane" "__wt_install_deps && __wt_herdr_setup --prompt=$prompt_arg" >/dev/null 2>&1

    echo "Workspace '$branch' ($ws_id) created for JIRA ticket $jira_key."
  elif __wt_in_cmux; then
    jira_prompt="${jira_prompt_pre}cmux workspace-action --action rename --title \"${jira_key} <short-title>\"${jira_prompt_post}"

    local ws_uuid
    ws_uuid=$(cmux new-workspace 2>/dev/null | awk '{print $2}')
    if [[ -z "$ws_uuid" ]]; then
      echo "cmux: failed to create new workspace"
      return 1
    fi

    cmux workspace-action --action rename --workspace "$ws_uuid" --title "$branch" 2>/dev/null

    local ws_pane ws_surface
    ws_pane=$(cmux list-panes --workspace "$ws_uuid" 2>/dev/null | grep -oE 'pane:[0-9]+' | head -1)
    ws_surface=$(cmux list-pane-surfaces --workspace "$ws_uuid" --pane "$ws_pane" 2>/dev/null | grep -oE 'surface:[0-9]+' | head -1)

    # %q-escape the prompt so it survives being embedded in the outer command string.
    prompt_arg=$(printf '%q' "$jira_prompt")

    cmux send --workspace "$ws_uuid" --surface "$ws_surface" \
      "cd '$repo_root' && git fetch origin main && wt switch --create --base origin/main $branch && __wt_install_deps && __wt_cmux_setup --prompt=$prompt_arg"$'\n' 2>/dev/null

    echo "Workspace '$branch' created for JIRA ticket $jira_key."
  else
    cd "$repo_root" && git fetch origin main && wt switch --create --base origin/main "$branch" && __wt_install_deps || return 1
    echo ""
    echo "Worktree created for $jira_key: $PWD"
    echo "(no herdr/cmux session — start claude manually with: claude --permission-mode auto)"
  fi
}

wtd() {
  local current_branch
  current_branch=$(git branch --show-current 2>/dev/null)

  if [[ -z "$current_branch" ]]; then
    echo "Error: not in a git repository"
    return 1
  fi

  local main_worktree
  main_worktree=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')

  if [[ "$PWD" == "$main_worktree" ]] || [[ "$PWD" == "$main_worktree"/* ]]; then
    echo "Error: already in the main worktree — nothing to remove"
    return 1
  fi

  # Capture the workspace this worktree lives in before leaving it
  local worktree_path ws_id="$CMUX_WORKSPACE_ID" herdr_ws="$HERDR_WORKSPACE_ID"
  worktree_path=$(git rev-parse --show-toplevel 2>/dev/null)

  echo "Removing worktree: $current_branch"
  cd "$main_worktree" || return 1
  wt remove --yes --foreground --force "$current_branch"
  git remote prune origin 2>/dev/null
  git branch -D "$current_branch" 2>/dev/null
  echo "Back in main worktree: $main_worktree"

  # Close the workspace we were inside, but only when it is the one bound to the
  # worktree just removed — otherwise this closes the workspace of a plain `cd`.
  if __wt_in_herdr && [[ -n "$herdr_ws" ]]; then
    local bound_path
    bound_path=$(herdr workspace get "$herdr_ws" 2>/dev/null \
      | jq -r '.result.workspace.worktree.checkout_path // empty')
    if [[ -n "$bound_path" && "$bound_path" == "$worktree_path" ]]; then
      echo "Closing herdr workspace..."
      herdr workspace close "$herdr_ws" >/dev/null 2>&1
    fi
  elif command -v cmux &>/dev/null && [[ -n "$ws_id" ]]; then
    echo "Closing cmux workspace..."
    cmux close-workspace --workspace "$ws_id" 2>/dev/null
  fi
}
