# This zsh file will be included in oh-my-zsh zshrc

PATH="$PATH:$HOME/.bin";

# Claude Code with permissions skipped
alias clauded="claude --dangerously-skip-permissions"

source $HOME/.aliases

# If a local zshrc exists, source it
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

if [[ -a ~/.localrc ]]; then
    source ~/.localrc
fi
