# This zsh file will be included in oh-my-zsh zshrc

PATH="$PATH:$HOME/.bin";

# Claude Code with permissions skipped
alias ccd="claude --dangerously-skip-permissions"

# Claude Code in auto permission mode
alias cca="claude --permission-mode auto"

source $HOME/.aliases
source $HOME/.worktrunk-functions

# ASDF
. /opt/homebrew/opt/asdf/libexec/asdf.sh

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"

# If a local zshrc exists, source it
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

if [[ -a ~/.localrc ]]; then
    source ~/.localrc
fi
